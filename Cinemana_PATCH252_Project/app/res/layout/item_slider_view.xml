<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_slider_view_0"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">
    <com.shabakaty.cinemana.ui.home_fragment.SliderView
        android:id="@id/home_page_slider_recycler"
        android:tag="binding_1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:accessibilityLiveRegion="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    <com.rd.PageIndicatorView
        android:id="@id/pageIndicatorView"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:piv_animationType="none"
        app:piv_dynamicCount="true"
        app:piv_interactiveAnimation="false"
        app:piv_padding="5dp"
        app:piv_radius="3dp"
        app:piv_select="0"
        app:piv_selectedColor="#F5F6FA"
        app:piv_unselectedColor="#657080" />
</LinearLayout>

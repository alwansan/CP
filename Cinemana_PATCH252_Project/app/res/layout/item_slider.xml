<?xml version="1.0" encoding="utf-8"?>
<!-- Rebuilt editorial hero: keep the original binding IDs, title, details, and Watch action. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/slider_item_root_constraint"
    android:tag="layout/item_slider_0"
    android:layout_width="match_parent"
    android:layout_height="490dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:clipToOutline="false"
    android:longClickable="true">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@id/videoThumb"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:backgroundImage="@color/nuvio_home_surface"
        app:fadeDuration="140"
        app:placeholderImage="@drawable/ic_video_placeholder"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:background="@drawable/nuvio_hero_scrim"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:id="@id/item_slider_watch_now"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:minHeight="48dp"
        android:textColor="#111318"
        android:textSize="14sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        app:backgroundTint="#F5F6FA"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_play_new"
        app:iconTint="#111318"
        app:iconPadding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/HomePageWatchNowTextAppearance" />
    <TextView
        android:id="@id/item_slider_title"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/item_slider_watch_now"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@id/item_slider_description"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:textColor="#CDD2DC"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/item_slider_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

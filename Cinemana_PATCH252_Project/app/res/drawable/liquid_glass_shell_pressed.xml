<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed recipe: denser material and a reduced top specular band to suggest compression. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#F0202730" android:centerColor="#ED171D26" android:endColor="#F40A0E14" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#6BFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00111620" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>

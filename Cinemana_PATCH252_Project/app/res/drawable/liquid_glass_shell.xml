<?xml version="1.0" encoding="utf-8"?>
<!-- Layered material shell: tinted body, fixed top/left highlight, and inner cross-section edge.
     This XML provides material cues; it does not itself sample or refract the backdrop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#C61D2630" android:centerColor="#B218202A" android:endColor="#D20B1118" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#5CFFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="270" android:startColor="#2DFFFFFF" android:centerColor="#0DFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#20FFFFFF" android:centerColor="#08FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00111620" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>

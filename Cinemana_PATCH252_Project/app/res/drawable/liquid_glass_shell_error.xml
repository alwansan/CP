<?xml version="1.0" encoding="utf-8"?>
<!-- Error recipe: stable dark plate plus a solid semantic red edge, rather than a glow-only warning. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E613171D" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#FFC53637" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0013171D" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#35C53637" />
        </shape>
    </item>
</layer-list>
